# =============================================================================
# ForgeBoard — Environment Variables
# =============================================================================
# Copy this file to .env in the repository root:
#   cp .env.example .env
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser.
# All other variables are server-side only.
# =============================================================================

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Runtime environment: development | test | production
NODE_ENV=development

# Express API server port
PORT=4000

# ---------------------------------------------------------------------------
# Database (PostgreSQL)
# ---------------------------------------------------------------------------

# Prisma connection string — used for migrations and runtime queries
# In production: use a managed PostgreSQL instance with SSL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/forgeboard?schema=public"

# ---------------------------------------------------------------------------
# Cache / Real-Time State (Redis)
# ---------------------------------------------------------------------------

# Redis connection URL — used for sessions, Socket.IO adapter, rate limiting
# In production: use a managed Redis instance (Upstash, Redis Cloud, etc.)
REDIS_URL="redis://localhost:6379"

# ---------------------------------------------------------------------------
# Authentication & Sessions
# ---------------------------------------------------------------------------

# Secret used to sign session cookies (HMAC-SHA256)
# MUST be at least 16 characters. Use a cryptographically random string in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="forgeboard-dev-session-secret-at-least-16-chars"

# ---------------------------------------------------------------------------
# Frontend URLs (used by API for CORS, cookie domain, redirects)
# ---------------------------------------------------------------------------

# Public URL of the Next.js frontend — used for CORS origin and Socket.IO
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Public URL of the Express API — used by the Next.js frontend for fetch calls
NEXT_PUBLIC_API_URL="http://localhost:4000/api"

# Public URL for Socket.IO connections — used by the Next.js frontend
# Typically the API server base URL (without /api path)
NEXT_PUBLIC_SOCKET_URL="http://localhost:4000"

# ---------------------------------------------------------------------------
# GitHub Integration (optional — only needed if enabling GitHub features)
# ---------------------------------------------------------------------------

# GitHub OAuth App credentials — create at https://github.com/settings/developers
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Secret used to verify GitHub webhook payloads (HMAC SHA-256)
# Set this to the same value configured in the GitHub webhook settings
# GITHUB_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Encryption (optional — required in production if GitHub integration is enabled)
# ---------------------------------------------------------------------------

# AES-256-GCM key for encrypting GitHub access tokens at rest
# MUST be a 32-byte hex string (64 hex characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In development/test: falls back to zeroed buffer (insecure but functional)
# In production: REQUIRED if GitHub integration is enabled
# ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Observability & Monitoring (optional)
# ---------------------------------------------------------------------------

# Minimum log level: debug | info | warn | error
# Defaults to 'info' in production, 'debug' in development/test
LOG_LEVEL=info

# Sentry or compatible error monitoring DSN
# If omitted, unhandled errors are logged via structured JSON with stack traces
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
