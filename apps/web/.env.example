# ForgeBoard Frontend Environment Variables

# The base URL of the backend API
# Must be an absolute URL for server-side rendering, or relative for client-side if proxied.
# Typically http://localhost:3001/api in development
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# The base URL for the backend Socket.IO server
# Typically http://localhost:3001 in development
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
